#!/bin/bash
# BGYHub Mailbox Admin.app: double-click launcher (no Terminal needed).
# 1. Makes sure ~/BGYHub has the latest version of the mailbox admin (git, fast-forward only).
# 2. Starts the local app and opens it in the browser (purelymail/admin/launch.sh).
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

REPO="$HOME/BGYHub"
BRANCH="claude/bold-brahmagupta-tpfvmk"
REMOTE_URL="https://github.com/jamesruan0325-design/BGYHub.git"
LOGDIR="$REPO/purelymail/output"

alert() {
  osascript -e "display alert \"BGYHub Mailbox Admin\" message \"$1\" as critical" >/dev/null 2>&1
  exit 1
}
notify() { osascript -e "display notification \"$1\" with title \"BGYHub Mailbox Admin\"" >/dev/null 2>&1 || true; }
log() { mkdir -p "$LOGDIR" 2>/dev/null && echo "$(date '+%F %T') $*" >> "$LOGDIR/launcher.log"; }

command -v git >/dev/null 2>&1 || alert "Git is not installed. When macOS offers to install the Command Line Developer Tools, click Install, then open this app again."

if [ ! -d "$REPO/.git" ]; then
  if [ -e "$REPO" ]; then
    alert "The folder $REPO exists but is not the BGYHub project. Rename it, then open this app again."
  fi
  notify "Downloading BGYHub (first start)…"
  git clone -q -b "$BRANCH" "$REMOTE_URL" "$REPO" >/dev/null 2>&1 \
    || alert "Could not download BGYHub. Check your internet connection and try again."
fi

cd "$REPO" || alert "Cannot open $REPO"
mkdir -p "$LOGDIR"
current="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
if [ "$current" != "$BRANCH" ]; then
  if git diff --quiet && git diff --cached --quiet; then
    git fetch -q origin "$BRANCH" >>"$LOGDIR/launcher.log" 2>&1 \
      && git checkout -q "$BRANCH" >>"$LOGDIR/launcher.log" 2>&1 \
      || git checkout -q -b "$BRANCH" "origin/$BRANCH" >>"$LOGDIR/launcher.log" 2>&1 \
      || alert "Could not switch ~/BGYHub to the mailbox admin version. See purelymail/output/launcher.log"
  else
    alert "~/BGYHub has unsaved changes on branch $current, so it was not switched. Ask for help before continuing."
  fi
fi
if git pull -q --ff-only origin "$BRANCH" >>"$LOGDIR/launcher.log" 2>&1; then
  log "updated to $(git rev-parse --short HEAD)"
else
  log "update skipped (offline or local changes); using $(git rev-parse --short HEAD)"
  notify "Could not check for updates; starting the current version."
fi

LAUNCH="$REPO/purelymail/admin/launch.sh"
[ -f "$LAUNCH" ] || alert "The mailbox admin files are missing from $REPO/purelymail."
exec /bin/bash "$LAUNCH"
