# ---- Shopify (custom app created in the S. MORI store) ----
# Store's myshopify domain (from the live site: smori-9216.myshopify.com)
SHOPIFY_SHOP=smori-9216.myshopify.com
# Admin API access token of the custom app (starts with shpat_). Never commit this.
SHOPIFY_ADMIN_TOKEN=
# Admin API version (quarterly; 2026-07 is the latest stable as of 2026-09)
SHOPIFY_API_VERSION=2026-07
# Store handle used to build admin links (the part after admin.shopify.com/store/)
SHOPIFY_STORE_HANDLE=smori-9216

# ---- Anthropic ----
# Read directly by the Anthropic SDK. Never commit this.
ANTHROPIC_API_KEY=
# Model used for copywriting (vision + structured output)
CLAUDE_MODEL=claude-opus-5

# ---- App ----
PORT=3000
DATA_DIR=./data
# Password for the web UI (HTTP basic auth, user "smori"). Leave empty only on a private machine.
ADMIN_PASSWORD=
# Metaobject type used by the theme
METAOBJECT_TYPE=installation_case
